PORT=7997
HOST=0.0.0.0
HIKARI_TOKEN=

JELLYSEERR_URL=http://your-server:5055
JELLYSEERR_API_KEY=
JELLYSEERR_PUBLIC_URL=

SONARR_URL=http://your-server:8989
SONARR_API_KEY=

RADARR_URL=http://your-server:7878
RADARR_API_KEY=

JELLYFIN_URL=http://your-server:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_LIBRARY_ID=

QBIT_URL=http://your-server:8080
QBIT_USER=
QBIT_PASS=

SHOKO_URL=http://your-server:8111
SHOKO_API_KEY=

ANIME_ROOT=/data/anime

ANILIST_TOKEN=
ANILIST_ALLOW_WRITES=false

# Set true only when a reverse proxy sits in front, otherwise the address limits are spoofable.
TRUST_PROXY=false
# API requests allowed per address per minute. Clamped to 30-100000.
RATE_LIMIT_PER_MINUTE=600

# Require a Jellyfin username and password before Hikari shows anything.
# Hikari keeps no accounts: Jellyfin checks the password.
AUTH=false
# How long a session lasts. Clamped to 1-365.
AUTH_SESSION_DAYS=30
AUTH_ADMINS_ONLY=false
# Comma separated. Blank allows any Jellyfin account.
AUTH_USERS=
# Where the session signing key lives. Default /cache/hikari-auth.json
AUTH_FILE=

# Links files Shoko hashed but AniDB never matched, so Jellyfin can see them.
# Writes to Shoko on a timer, so it is off unless you ask for it.
AUTO_LINK=false
AUTO_LINK_INTERVAL_MINUTES=60
# How long a new file is left for AniDB before Hikari links it by hand.
AUTO_LINK_GRACE_HOURS=6
AUTO_LINK_MAX_PER_RUN=20

# Where settings saved in the app are written. Default /cache/hikari-settings.json
SETTINGS_FILE=

CACHE_FILE=

# AniList -> TMDB id mapping, used so requests are matched by id instead of by title. Downloaded on
# start, refreshed weekly, and cached to ANIME_MAPPING_FILE (default
# /cache/hikari-anime-mapping.json). Entirely optional: without it Hikari matches by title as before.
# Set ANIME_MAPPING_URL to serve the list from your own mirror instead of GitHub.
ANIME_MAPPING_URL=
ANIME_MAPPING_FILE=
